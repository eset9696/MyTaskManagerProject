@model MyTaskManagerProject.Models.Domain.User

<div class="container w-25 p-3">
    @if (ViewBag.ErrorMessage is not null)
    {
        <p class="alert alert-danger">@ViewBag.ErrorMessage</p>
    }
    @if (ViewBag.Message is not null)
    {
        <p class="alert alert-success">@ViewBag.Message</p>
    }

    <div class="p-2 m-3 align-self-center align-middle card">
        <div class="mb-2 align-self-center">
            <h4>Регистрация</h4>
        </div>
        <div class="m-2">
            <form method="post" asp-action="DoRegistration" asp-controller="Auth">
                <div class="mb-3">
                    <label class="form-label" asp-for="Login">Логин:</label>
                    <input class="form-control" asp-for="Login" type="text" name="Login" />
                    <span class="text-danger" asp-validation-for="Login"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Password">Пароль:</label>
                    <input class="form-control" asp-for="Password" type="password" name="Password" />
                    <span class="text-danger" asp-validation-for="Password"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Email">Адрес электронной почты:</label>
                    <input class="form-control" asp-for="Email" type="email" name="Email" />
                    <span class="text-danger" asp-validation-for="Email"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="PhoneNumber">Номер телефона:</label>
                    <input class="form-control" asp-for="PhoneNumber" type="tel" name="phoneNumber" />
                </div>
                <button class="btn btn-primary" type="submit">Зарегестрироваться</button>
            </form>
        </div>
    </div>
</div>