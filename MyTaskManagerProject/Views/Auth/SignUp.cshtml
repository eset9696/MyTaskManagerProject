@model MyTaskManagerProject.Models.Domain.User

<div class="container w-25 p-3">
    @if (ViewBag.ErrorMessage is not null)
    {
        <p class="alert alert-danger">@ViewBag.ErrorMessage</p>
    }
    @if (ViewBag.Message is not null)
    {
        <p class="alert alert-success">@ViewBag.Message</p>
    }

    <div class="p-2 m-3 align-self-center align-middle card">
        <div class="mb-2 align-self-center">
            <h4>Регистрация</h4>
        </div>
        <div class="m-2">
            <form method="post" asp-action="DoRegistration" asp-controller="Auth">
                <div class="mb-3">
                    <label class="form-label" asp-for="@Model.Login">Логин:</label>
                    <input class="form-control" asp-for="@Model.Login" type="text" name="login" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="@Model.Password">Пароль:</label>
                    <input class="form-control" asp-for="@Model.Password" type="password" name="password" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="@Model.Email">Адрес электронной почты:</label>
                    <input class="form-control" asp-for="@Model.Email" type="email" name="email" />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="@Model.PhoneNumber">Номер телефона:</label>
                    <input class="form-control" asp-for="@Model.PhoneNumber" type="tel" name="phoneNumber" />
                </div>
                <button class="btn btn-primary" type="submit">Зарегестрироваться</button>
            </form>
        </div>
    </div>
</div>